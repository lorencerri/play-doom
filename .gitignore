# Secrets and local overrides.
.env

# Build output. There is no build step for the TypeScript — this is left for anything
# that writes one.
dist

# The SQLite database and everything the renders write: frames, videos, controller
# tiles, death clips. `data/*` rather than `data/` so the directory itself can be
# committed if it ever needs a .gitkeep.
*.sqlite
data/*

# The doomgeneric source now lives in vendor/. This is the old submodule checkout,
# left on disk so nothing is lost — safe to delete. Anchored with a leading slash:
# unanchored, it would also match the vendored copy at vendor/doomreplay/.
/doomreplay/

# Build output from the vendored C sources. The sources themselves are tracked.
vendor/**/*.o
vendor/doomreplay/doomgeneric/doomgeneric

# Dependencies.
node_modules/

# Editors and OS noise.
.idea/
.vscode/
.DS_Store
Thumbs.db
